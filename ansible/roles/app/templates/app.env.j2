DB_URL={{ ('jdbc:postgresql://' ~ db_host ~ ':' ~ db_port ~ '/' ~ db_name) | quote }}
DB_USER={{ db_user | quote }}
DB_PASSWORD={{ db_password | quote }}
SERVER_PORT={{ app_port }}
JAVA_TOOL_OPTIONS='-Xms64m -Xmx256m -XX:+ExitOnOutOfMemoryError'
SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=60000
